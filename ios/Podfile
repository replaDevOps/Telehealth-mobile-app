# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# Fix Node path for Hermes
ENV['NODE_BINARY'] = `which node`.strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# Build the Firebase SDK as static frameworks. Required by react-native-firebase
# when using a Swift Firebase pod (FirebaseAuth) alongside others (Messaging).
$RNFirebaseAsStaticFramework = true

target 'Telehealth' do
  pod 'RNVectorIcons', :path => '../node_modules/react-native-vector-icons'

  # react-native-firebase with FirebaseAuth (a Swift pod) requires Firebase to be
  # built as static frameworks. Without this, RNFBMessaging fails with
  # "'FirebaseAuth/FirebaseAuth-Swift.h' file not found".
  use_frameworks! :linkage => :static

  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
  end
end